# Copy to .env.local and adjust. Server-side only: never prefix these with NEXT_PUBLIC_.

# Required. Ollama server and model; there are no fallbacks, so a missing value is an error
# rather than a silent switch to another Ollama instance or model.
# The remote Linux Ollama listens on its own 127.0.0.1:11434 only. Reach it through an SSH tunnel:
#   ssh -N -L 11435:127.0.0.1:11434 user@SERVER_IP
OLLAMA_BASE_URL=http://127.0.0.1:11435
# Must match a name from `ollama list` on that server
OLLAMA_MODEL=qwen3:8b

# Optional; these are the defaults.
# Keep them stable: changing num_ctx makes Ollama reload the model.
# Context window in tokens, sent as options.num_ctx on every request (tool step, final answer,
# system-prompt measurement). Positive integer; defaults to 4096 if unset or invalid. qwen3:8b
# supports up to 40960; 32768 uses roughly 4.5 GiB more VRAM than 4096 (fp16 KV cache).
OLLAMA_NUM_CTX=32768
# Max tokens per model response, reserved in the context budget. ERP responses are JSON arrays of
# several 8-key objects, so 2048 leaves room for lists and charts (default 1024).
OLLAMA_NUM_PREDICT=2048
OLLAMA_TEMPERATURE=0
# How long Ollama keeps the model loaded after the last request
OLLAMA_KEEP_ALIVE=30m
# Give up if Ollama sends nothing for this long (covers the first model load)
OLLAMA_TIMEOUT_MS=120000

# Optional: MCP server whose tools the model may call (server-side only, never sent to the browser).
# Leave MCP_SERVER_URL empty to disable tools. mcp.example.com serves Streamable HTTP at "/".
MCP_SERVER_URL=https://mcp.example.com
# Database the MCP server should use, sent as X-Erp-Server/-Database/-Username/-Password/-Ssl headers
# (as the GreenXERP backend does). Server-side only: never prefix with NEXT_PUBLIC_, never commit real
# values. Use a read-only database login. Leave all empty to connect without database headers.
ERP_SERVER=<SQL_SERVER_HOST,PORT>
ERP_DATABASE=<DATABASE_NAME>
ERP_USERNAME=<DATABASE_USERNAME>
ERP_PASSWORD=<DATABASE_PASSWORD>
# true or false (sent as "True"/"False", like .NET's bool.ToString())
ERP_SSL=false
# Comma-separated tools the model may call. Default: read-only lookups plus get_context_specific_prompt
# (required by the ERP Query workflow; its arguments are checked against the domains/systems metadata).
# Tools that take credentials as arguments (run_sql_query) are never offered, whatever this says.
MCP_ALLOWED_TOOLS=get_status,get_table_ai_struct,get_form_types,get_form_records,get_entity_clearance,get_context_specific_prompt
MCP_CONNECT_TIMEOUT_MS=10000
MCP_TOOL_TIMEOUT_MS=20000
# Characters of each tool result passed to the model
MCP_MAX_RESULT_CHARS=3000

# Max recent messages sent as context; older ones are also dropped to fit OLLAMA_NUM_CTX.
# The ERP system prompt is always sent first and never dropped.
CHAT_HISTORY_LIMIT=20

# --- Where the assistant's database knowledge comes from ---
# mcp  (default): the ERP system prompt, the MCP server and the backend workflow.
# file: file-based SQL assistant. Uses prompts/file-mode-system-prompt.txt and one server-side database
#       metadata file for every conversation (nothing is uploaded). No MCP connection, no tools,
#       no database connection, nothing executed: generated SELECT queries are only shown.
# hybrid: the file-based assistant with live data. Same metadata file, retrieval and SQL validation
#       (prompts/hybrid-system-prompt.txt; the file-mode prompt stays the fallback). Each query is also
#       checked against the live schema through MCP (get_table_ai_struct, server-side; the model gets no
#       tools), and runs only when ERP_SQL_EXECUTION=enabled AND the login passed the least-privilege
#       check. The model then answers from the returned rows; charts are drawn from the rows.
#       Needs MCP_SERVER_URL and the ERP_* connection. Choosing hybrid does NOT enable execution.
# mcp-agent: a general MCP assistant. No ERP prompt, metadata file, SQL generation or SQL validation:
#       the model gets the allowlisted MCP tools through Ollama's native tool calling and a few lines of
#       instructions (prompts/mcp-agent-system-prompt.txt); the backend authorizes, validates and runs each
#       call and shows every call with its real result. Needs MCP_SERVER_URL (and the ERP_* connection for
#       tools that read the database). No SQL is executed by the app in this mode.
ERP_CONTEXT_SOURCE=mcp
# File and hybrid mode: the metadata file (server-only; keep it out of public/). Re-read when it changes.
ERP_METADATA_FILE=data/table-list.txt
# Hybrid mode: how long a live table structure is cached (per server, database and login).
ERP_LIVE_SCHEMA_TTL_MS=600000

# --- MCP Agent mode (ERP_CONTEXT_SOURCE=mcp-agent) ---
# Tools the model may call, comma-separated. Default (verified read-only lookups, 2026-10-25):
#   get_status,get_domains_systems,list_intents,get_intent_procedures,get_form_types,get_form_records,
#   get_table_ai_struct,list_ai_actions,get_ai_action_prompt,get_context_specific_prompt
# get_entity_clearance is off by default (searches any table/column the caller names). run_sql_query
# (SQL + credential arguments) and get_request_headers (echoes the credential headers) are never offered,
# whatever this says; neither is a tool that asks for a password, username, key or token.
MCP_AGENT_ALLOWED_TOOLS=
# The agent's instructions; "none" sends no system message (only the tool definitions).
MCP_AGENT_PROMPT_FILE=prompts/mcp-agent-system-prompt.txt
# Bounds per user message: tool calls, model requests that may call tools, total time for tool use,
# and characters of one tool result passed to the model (the whole result is still shown in the chat,
# up to 20,000 characters). Each call also has MCP_TOOL_TIMEOUT_MS.
MCP_AGENT_MAX_TOOL_CALLS=8
MCP_AGENT_MAX_ROUNDS=6
MCP_AGENT_TURN_TIMEOUT_MS=180000
MCP_AGENT_MAX_RESULT_CHARS=8000

# --- ERP system prompt ---
# prompts/erp-system-prompt.txt is sent unchanged and verified by SHA-256 on every request. It contains
# the intent list and the ERP domains/systems; the backend parses them from it (no separate metadata).
# Only after deliberately replacing the file: ERP_PROMPT_FILE=... and ERP_PROMPT_SHA256=<sha256 of the new file>.

# --- Backend execution of procedures and SELECTs (mssql, using the ERP_* connection above) ---
# Off unless "enabled". Even then, nothing runs until a live check confirms the login is least-privilege:
# no server role or permission beyond connecting; no db_owner/db_datawriter/db_ddladmin/db_securityadmin/
# db_accessadmin/db_backupoperator role; no effective database permission beyond CONNECT, SELECT, SHOWPLAN,
# VIEW DEFINITION, VIEW DATABASE STATE, REFERENCES (so no INSERT/UPDATE/DELETE/ALTER/CONTROL/CREATE/EXECUTE);
# no write, ALTER or EXECUTE on any gnd_* schema and no writable table. Use a dedicated read-only login.
# Every statement also has a timeout and a row limit and runs in a rolled-back transaction (last layer).
ERP_SQL_EXECUTION=disabled
# Hybrid mode execution policy: schemas a query may read ("*" wildcard), tables it never reads, and the
# maximum number of JOINs. Every table must also be documented in the metadata file and exist live.
ERP_SQL_ALLOWED_SCHEMAS=gnd_*
ERP_SQL_DENIED_TABLES=
ERP_SQL_MAX_JOINS=8
ERP_SQL_TIMEOUT_MS=15000
ERP_SQL_MAX_ROWS=200
ERP_SQL_MAX_RESULT_CHARS=12000
# Accept a self-signed SQL Server certificate when ERP_SSL=true
ERP_SQL_TRUST_SERVER_CERTIFICATE=false
# Optional API key required in X-API-Key header for ERP backend calls
ERP_AI_API_KEY=<OPTIONAL_SECRET_API_KEY>
